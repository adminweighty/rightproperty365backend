{{define "preheader"}}Invoice {{.InvoiceNumber}} for {{.Amount}} has been issued.{{end}}
{{define "heading"}}Invoice issued{{end}}
{{define "button"}}View invoice{{end}}
{{define "why"}}You are receiving this because your RightProperty365 account has a paid plan.{{end}}
{{define "body"}}
<p class="ink" style="margin:0 0 16px;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:24px;color:#131722;">{{if .Name}}Hello {{.Name}},{{else}}Hello,{{end}}</p>
<p class="ink" style="margin:0 0 16px;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:24px;color:#131722;">A renewal invoice has been issued for your account.</p>
<table role="presentation" class="facts" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 20px;background-color:#f8f9fc;border:1px solid #e6e9f0;border-radius:10px;"><tr><td style="padding:14px 16px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="fact-label" valign="top" width="38%" style="padding:4px 12px 4px 0;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:21px;color:#4f586a;">Invoice</td><td class="ink" valign="top" style="padding:4px 0;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:21px;font-weight:600;color:#131722;">{{.InvoiceNumber}}</td></tr><tr><td class="fact-label" valign="top" width="38%" style="padding:4px 12px 4px 0;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:21px;color:#4f586a;">Amount</td><td class="ink" valign="top" style="padding:4px 0;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:21px;font-weight:600;color:#131722;">{{.Amount}}</td></tr><tr><td class="fact-label" valign="top" width="38%" style="padding:4px 12px 4px 0;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:21px;color:#4f586a;">Due</td><td class="ink" valign="top" style="padding:4px 0;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:21px;font-weight:600;color:#131722;">{{date .DueOn}}</td></tr></table></td></tr></table>
<p class="muted" style="margin:0 0 16px;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:21px;color:#4f586a;">This invoice has not been paid yet.</p>
{{end}}
