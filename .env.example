# Copy to .env for local development. .env is gitignored — never commit real values.
# In staging/production inject these as real environment variables / secrets.

# development | staging | production
APP_ENV=development

# Address the API listens on.
HTTP_ADDR=:8080

# PostgreSQL connection string for the self-hosted database server. This is
# the ONE required database setting in staging and production. Leave it empty
# in development to run on in-memory stores.
# Example shape: postgresql://USER:PASSWORD@DB_HOST:5432/DBNAME?sslmode=require
# TLS: use sslmode=require (or verify-full with the server's CA) whenever the
# API and the database are on different hosts. Without sslmode the client
# defaults to "prefer", which can silently fall back to no encryption.
# Local docker-compose Postgres: ...@localhost:5432/rp365?sslmode=disable
DATABASE_URL=

# session (default): DATABASE_URL connects straight to PostgreSQL.
# transaction: DATABASE_URL goes through PgBouncer in transaction-pooling mode.
DB_POOL_MODE=session

# OPTIONAL. Only needed with DB_POOL_MODE=transaction: a direct PostgreSQL
# connection for cmd/migrate (and adminctl / seed), which cannot run through a
# transaction pooler. Leave empty otherwise; DATABASE_URL is used.
DATABASE_DIRECT_URL=

# Upper bound on connections PER PROCESS (each API replica and the worker open
# their own pool). Keep (API replicas + workers) x DB_MAX_CONNS, plus a few
# for migrations, backups and psql, well under the server's max_connections.
DB_MAX_CONNS=8

# Comma-separated exact origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# debug | info | warn | error
LOG_LEVEL=info

# Public origin of the web app. Every link and logo URL in an email is built
# from it. (WEB_BASE_URL is still read as a deprecated alias.)
PUBLIC_WEB_URL=http://localhost:3000

# --- Search (Elasticsearch) -------------------------------------------------
# Which engine answers GET /v1/listings: database | elasticsearch. Leave empty
# for automatic selection: elasticsearch when ELASTICSEARCH_URL is set,
# otherwise the database adapter. SEARCH_DRIVER=elasticsearch without a URL
# fails startup.
SEARCH_DRIVER=

# Cluster address, without credentials. Local docker-compose: http://localhost:9200
ELASTICSEARCH_URL=

# Elasticsearch API key (the base64 "id:api_key" value). NEVER commit a real
# key. Leave empty for the local docker-compose node, which has security off.
ELASTICSEARCH_API_KEY=

# Names this environment's indices: <prefix>-listings-<timestamp>, read
# through the alias <prefix>-listings-current. Default: rp365-<APP_ENV>.
SEARCH_INDEX_PREFIX=

# How long one search request may take before it is abandoned and answered
# from the database instead (50ms..5s). The search target is a p95 of 1s.
SEARCH_TIMEOUT=800ms

# --- File storage (onboarding documents) -----------------------------------
# Where private files are kept: local | s3. Leave empty in development for
# "local". Staging and production MUST use s3: startup fails otherwise.
STORAGE_DRIVER=

# local driver: the folder files are written to (git-ignored).
STORAGE_LOCAL_DIR=tmp/uploads

# s3 driver: an S3-compatible store such as MinIO. The bucket must already
# exist and must NOT be public. NEVER commit a real secret key.
# Local docker-compose MinIO: http://localhost:9000 with the root user and
# password from docker-compose.yml, after creating a bucket in its console.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
# true = <endpoint>/<bucket>/<key> (MinIO); false = <bucket>.<endpoint>/<key>.
S3_USE_PATH_STYLE=true

# --- Malware scanning of uploads (API 0.41.0) --------------------------------
# none (the default: nothing is scanned, uploads behave as before) | clamav.
# The ClamAV host (clamd, with freshclam keeping signatures current) is yours
# to run; set the same values on the API and the worker. Images are scanned on
# upload (503 SCANNER_UNAVAILABLE while clamd is down); documents are
# quarantined until the worker has scanned them.
MALWARE_SCANNER=none
# clamd over TCP, host:port (required with clamav). Never expose it publicly.
CLAMD_ADDRESS=
# One scan: connect, stream and verdict (1s..10m).
MALWARE_SCAN_TIMEOUT=60s
# Must equal clamd's StreamMaxLength (default 25M = 26214400); at least 20 MB.
MALWARE_SCAN_MAX_BYTES=26214400

# --- Online payment of subscription invoices (API 0.42.0) --------------------
# none (the default: not offered; invoices are paid by transfer and recorded
# by finance) | fake (development and staging ONLY: a hosted page served by
# the API, nothing charged; startup fails with APP_ENV=production). No real
# provider is built yet: one adds its name here and its credentials as
# secrets from the deployment's secret store (never this file).
PAYMENT_GATEWAY=none
# fake only: signs the fake webhooks (at least 16 characters). Empty = random
# per process; set it when several API instances run.
PAYMENT_FAKE_WEBHOOK_SECRET=
# An open checkout older than this is checked with the provider (1m..24h).
PAYMENT_RECONCILE_AFTER=15m

# --- Email (Resend) ---------------------------------------------------------
# Resend API key. NEVER commit a real key: put it only in your local .env or,
# in production, in a Kubernetes Secret. Leave empty here.
RESEND_API_KEY=

# Which mailer runs: resend | log. Leave empty for automatic selection:
#   - RESEND_API_KEY set   -> resend (REAL email is sent)
#   - no key, development  -> log (nothing is sent; messages go to the log)
#   - no key, staging/prod -> startup fails
# MAIL_DRIVER=log forces the log mailer even when a key is set (development
# only; refused in staging and production). Use it for any local run that
# must not send real email.
MAIL_DRIVER=

# Sender. Resend only sends from a domain whose DNS records are verified in
# the Resend account.
EMAIL_FROM=RightProperty365 <no-reply@rightproperty365.com>

# Optional Reply-To address.
EMAIL_REPLY_TO=

# DEVELOPMENT ONLY. Shared password of the in-memory seed users
# (consumer@ / agent@ / admin@ / agent-b@example.test). This is a deliberately
# fake, public value: it is ignored unless APP_ENV=development and the seed
# users only exist in the in-memory store. Leave it empty to skip seeding users.
DEV_SEED_PASSWORD=dev-only-not-a-secret-123

# Administrator sessions (POST /v1/admin/auth/login). Go durations, 1m..24h.
# ADMIN_SESSION_TTL is the absolute lifetime; ADMIN_SESSION_IDLE_TTL signs an
# administrator out after that long without a request (must not exceed the TTL).
ADMIN_SESSION_TTL=12h
ADMIN_SESSION_IDLE_TTL=30m

# Administrator MFA (API 0.40.0): an authenticator app (TOTP) plus recovery
# codes, as a third step of the administrator sign-in.
# ADMIN_MFA_REQUIRED: true makes administrators without an authenticator sign
# in to an enrolment-only session (they must set one up first). Default true
# in production, false in development and staging.
# MFA_ENCRYPTION_KEY: 32 random bytes in base64 (openssl rand -base64 32), a
# SECRET that seals the TOTP secrets (AES-256-GCM). Required outside
# development when ADMIN_MFA_REQUIRED is true (the API refuses to start).
# Without it in development a FIXED, publicly known development key is used
# (loud warning at startup). Changing it makes every enrolled authenticator
# unusable: reset them. Leave it commented out in development.
# ADMIN_MFA_REQUIRED=false
# MFA_ENCRYPTION_KEY=

# --- Push notifications (FCM HTTP v1, which carries APNs) ----------------------
# Firebase project id, for example rightproperty365. The service account is a
# SECRET with the "Firebase Cloud Messaging API Admin" role: give it as the JSON
# itself (FCM_SERVICE_ACCOUNT_JSON) or as the path of the key file
# (FCM_SERVICE_ACCOUNT_FILE, e.g. a mounted Kubernetes Secret). NEVER commit a
# real key. Leave all three empty here: without them push is DISABLED in
# staging/production (one log line, never a startup failure) and the log
# pusher is used in development (nothing is sent). The key is never logged.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
FCM_SERVICE_ACCOUNT_JSON=

# --- Listing analytics -------------------------------------------------------
# How many days raw analytics events are kept before the worker deletes them
# (7..3650). The daily rollups are kept; only the raw events go.
ANALYTICS_RAW_RETENTION_DAYS=90

# Signing in is two steps: the password, then a six-digit code emailed to the
# account. AUTH_DEMO_CODE is a DEMO code (4 to 6 digits, for example 1234) that
# is ALSO accepted for every sign-in, so testers can sign in to the sample
# accounts (@example.test addresses, which are never emailed) without a
# mailbox. Honoured only when APP_ENV is development or staging: if it is set
# with APP_ENV=production the API and the worker REFUSE TO START. The API logs
# a warning at startup while it is active (never the code itself). Leave it
# commented out unless you need it; in development the log mailer also prints
# each emailed code.
# AUTH_DEMO_CODE=1234

# cmd/adminctl only: the new administrator's password, as an alternative to
# typing it or piping it on stdin. Never put a real value in a file; prefer
# stdin. Leave empty here.
ADMINCTL_PASSWORD=
