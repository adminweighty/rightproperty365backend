# Copy to .env for local development. .env is gitignored — never commit real values.
# In staging/production inject these as real environment variables / secrets.

# development | staging | production
APP_ENV=development

# Address the API listens on.
HTTP_ADDR=:8080

# Runtime connection: the POOLED Neon URL (host contains "-pooler", PgBouncer
# transaction mode). Leave empty in development to run on in-memory stores.
# Required in staging and production.
# Example shape: postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=

# Migrations only: the DIRECT (non-pooled) Neon URL. Used by cmd/migrate.
# Example shape: postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_DIRECT_URL=

# Upper bound on connections per process (API and worker each open their own pool).
DB_MAX_CONNS=8

# Comma-separated exact origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# debug | info | warn | error
LOG_LEVEL=info

# Frontend base URL used to build the links in verification / password-reset emails.
WEB_BASE_URL=http://localhost:3000

# DEVELOPMENT ONLY. Shared password of the in-memory seed users
# (consumer@ / agent@ / admin@ / agent-b@example.test). This is a deliberately
# fake, public value: it is ignored unless APP_ENV=development and the seed
# users only exist in the in-memory store. Leave it empty to skip seeding users.
DEV_SEED_PASSWORD=dev-only-not-a-secret-123

# Administrator sessions (POST /v1/admin/auth/login). Go durations, 1m..24h.
# ADMIN_SESSION_TTL is the absolute lifetime; ADMIN_SESSION_IDLE_TTL signs an
# administrator out after that long without a request (must not exceed the TTL).
ADMIN_SESSION_TTL=12h
ADMIN_SESSION_IDLE_TTL=30m

# cmd/adminctl only: the new administrator's password, as an alternative to
# typing it or piping it on stdin. Never put a real value in a file; prefer
# stdin. Leave empty here.
ADMINCTL_PASSWORD=
