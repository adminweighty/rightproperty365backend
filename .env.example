# Copy to .env for local development. .env is gitignored — never commit real values.
# In staging/production inject these as real environment variables / secrets.

# development | staging | production
APP_ENV=development

# Address the API listens on.
HTTP_ADDR=:8080

# PostgreSQL connection string for the self-hosted database server. This is
# the ONE required database setting in staging and production. Leave it empty
# in development to run on in-memory stores.
# Example shape: postgresql://USER:PASSWORD@DB_HOST:5432/DBNAME?sslmode=require
# TLS: use sslmode=require (or verify-full with the server's CA) whenever the
# API and the database are on different hosts. Without sslmode the client
# defaults to "prefer", which can silently fall back to no encryption.
# Local docker-compose Postgres: ...@localhost:5432/rp365?sslmode=disable
DATABASE_URL=

# session (default): DATABASE_URL connects straight to PostgreSQL.
# transaction: DATABASE_URL goes through PgBouncer in transaction-pooling mode.
DB_POOL_MODE=session

# OPTIONAL. Only needed with DB_POOL_MODE=transaction: a direct PostgreSQL
# connection for cmd/migrate (and adminctl / seed), which cannot run through a
# transaction pooler. Leave empty otherwise; DATABASE_URL is used.
DATABASE_DIRECT_URL=

# Upper bound on connections PER PROCESS (each API replica and the worker open
# their own pool). Keep (API replicas + workers) x DB_MAX_CONNS, plus a few
# for migrations, backups and psql, well under the server's max_connections.
DB_MAX_CONNS=8

# Comma-separated exact origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# debug | info | warn | error
LOG_LEVEL=info

# Frontend base URL used to build the links in verification / password-reset emails.
WEB_BASE_URL=http://localhost:3000

# DEVELOPMENT ONLY. Shared password of the in-memory seed users
# (consumer@ / agent@ / admin@ / agent-b@example.test). This is a deliberately
# fake, public value: it is ignored unless APP_ENV=development and the seed
# users only exist in the in-memory store. Leave it empty to skip seeding users.
DEV_SEED_PASSWORD=dev-only-not-a-secret-123

# Administrator sessions (POST /v1/admin/auth/login). Go durations, 1m..24h.
# ADMIN_SESSION_TTL is the absolute lifetime; ADMIN_SESSION_IDLE_TTL signs an
# administrator out after that long without a request (must not exceed the TTL).
ADMIN_SESSION_TTL=12h
ADMIN_SESSION_IDLE_TTL=30m

# cmd/adminctl only: the new administrator's password, as an alternative to
# typing it or piping it on stdin. Never put a real value in a file; prefer
# stdin. Leave empty here.
ADMINCTL_PASSWORD=
